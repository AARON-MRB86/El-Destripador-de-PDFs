# Copia este archivo a .env y reemplaza las contraseñas antes de usar.
# NO subas `.env` al repositorio — contiene secretos.

MONGO_INITDB_ROOT_USERNAME=admin
# Reemplaza por una contraseña segura (ej: generada con openssl/random)
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DATABASE_URL=mongodb://admin:REPLACE_WITH_SECURE_PASSWORD@mongodb:27017
DATABASE_NAME=pdf_extract
DATABASE_TIMEOUT_MS=3000

# Credenciales de acceso a mongo-express (UI de desarrollo)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MONGO_EXPRESS_PORT=8081
